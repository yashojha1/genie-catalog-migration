# ============================================================
# Genie Space Catalog Migration - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control - it contains secrets!
#
# QUICK START:
#   1. cp .env.example .env
#   2. Fill in your workspace details and catalog names
#   3. Run: python main.py
# ============================================================

# ============================================================
# SECTION 1: Workspace Configuration
# ============================================================
# Your Databricks workspace details (same workspace for source and target)

# Databricks workspace URL (e.g., https://dbc-xxxx.cloud.databricks.com)
DATABRICKS_HOST=

# Databricks Personal Access Token with CAN_MANAGE on Genie spaces
# Generate at: <HOST>/user-settings/tokens
DATABRICKS_TOKEN=

# SQL Warehouse ID for Genie operations
# Find at: <HOST>/sql/warehouses
DATABRICKS_WAREHOUSE_ID=


# ============================================================
# SECTION 2: Genie Space Configuration
# ============================================================
# The Genie Space you want to migrate

# The Genie Space ID to migrate
# Find this in the URL: /genie/spaces/<SPACE_ID>
GENIE_SPACE_ID=

# (Optional) Leave blank to keep the same title, or set a new title
NEW_TITLE=


# ============================================================
# SECTION 3: Catalog Migration Settings
# ============================================================
# Define how catalogs should be remapped

# Source catalog name (current catalog used in the Genie space)
SOURCE_CATALOG=

# Target catalog name (new catalog to migrate to)
TARGET_CATALOG=


# ============================================================
# SECTION 4: Schema Mapping (Optional)
# ============================================================
# Map schema names if they differ between catalogs.
# Format: "source_schema1:target_schema1,source_schema2:target_schema2"
#
# Examples:
#   Same names:   (leave empty or comment out)
#   Single map:   bronze:bronze_uat
#   Multiple:     bronze:bronze_uat,silver:silver_uat,gold:gold_uat
#
# Leave empty if schema names are identical in both catalogs.

SCHEMA_MAP=


# ============================================================
# SECTION 5: Deployment Settings
# ============================================================
# Configure how the migration is performed

# Migration mode: "update" (modify existing) or "clone" (create new copy)
# Default: update
MIGRATION_MODE=clone

# Workspace folder path for the Genie space (used in clone mode)
# Use forward slashes. Folder will be created if it doesn't exist.
PARENT_PATH=/Workspace/Genie/Migrated

# Title suffix for cloned spaces (helps identify migrated copies)
TITLE_SUFFIX= [PROD]


# ============================================================
# SECTION 6: Output / Artifact Storage
# ============================================================
# Local directory where exported and transformed JSON files are saved.

OUT_DIR=./artifacts


# ============================================================
# TROUBLESHOOTING
# ============================================================
# - 401 Unauthorized: Check that your token is correct and not expired
# - 404 Not Found: Verify your GENIE_SPACE_ID (should be 32 hex characters)
# - Permission errors: Ensure you have CAN_MANAGE on the Genie space
# - Catalog errors: Verify the target catalog exists in your workspace
# ============================================================
